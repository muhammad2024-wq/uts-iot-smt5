// UTS IoT No.4 - Palang otomatis: servo SG90 + sensor ultrasonik HC-SR04
// Servo -> GPIO18, TRIG -> GPIO5, ECHO -> GPIO17
// Jarak < 10 cm -> servo 90 derajat (terbuka), selain itu 0 derajat (tertutup)

#include <ESP32Servo.h>

const int SERVO_PIN = 18;
const int TRIG_PIN  = 5;
const int ECHO_PIN  = 17;

const float THRESHOLD_CM = 10.0;
const int ANGLE_OPEN   = 90;
const int ANGLE_CLOSED = 0;

Servo gate;
int currentAngle = -1;   // -1 supaya posisi awal pasti ditulis

// Mengukur jarak dalam cm. Mengembalikan 999 jika tidak ada pantulan.
float readDistanceCm() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);  // timeout 30 ms (~5 m)
  if (duration == 0) return 999.0;
  return duration * 0.0343 / 2.0;                  // kecepatan suara 343 m/s
}

void setGate(int angle) {
  if (angle != currentAngle) {                     // gerakkan hanya jika berubah
    gate.write(angle);
    currentAngle = angle;
    Serial.printf("Palang %s (%d derajat)\n",
                  angle == ANGLE_OPEN ? "TERBUKA" : "TERTUTUP", angle);
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  gate.setPeriodHertz(50);
  gate.attach(SERVO_PIN, 500, 2400);
  setGate(ANGLE_CLOSED);
}

void loop() {
  float distance = readDistanceCm();
  Serial.printf("Jarak: %.1f cm\n", distance);

  if (distance < THRESHOLD_CM) setGate(ANGLE_OPEN);
  else                         setGate(ANGLE_CLOSED);

  delay(200);
}
